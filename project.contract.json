{
  "schemaVersion": 1,
  "id": "healthcare/assistverse",
  "owner": "Chief (dr. Ferdi Iskandar)",
  "risk": "R1",
  "runtime": {
    "name": "node",
    "version": "24"
  },
  "packageManager": {
    "name": "pnpm",
    "version": "11.21.0",
    "lockfile": "pnpm-lock.yaml"
  },
  "commands": {
    "install": {
      "program": "node",
      "args": [
        "scripts/pnpm.mjs",
        "install",
        "--frozen-lockfile"
      ],
      "timeoutSeconds": 600
    },
    "lint": {
      "program": null,
      "args": [],
      "notApplicableReason": "ESLint (config from the standalone repo, 2026-09-27) reports 4 react-hooks/set-state-in-effect errors in capsule-only components (CommandPrompt, TerminalTypewriterSimple, useTypewriter); lint joins the contract once they are fixed."
    },
    "typecheck": {
      "program": "node",
      "args": [
        "scripts/pnpm.mjs",
        "run",
        "typecheck"
      ],
      "timeoutSeconds": 300
    },
    "test": {
      "program": "node",
      "args": [
        "scripts/pnpm.mjs",
        "run",
        "test"
      ],
      "timeoutSeconds": 300
    },
    "build": {
      "program": "node",
      "args": [
        "scripts/with-local-env.mjs",
        "run",
        "build"
      ],
      "timeoutSeconds": 600
    },
    "run": {
      "program": "node",
      "args": [
        "scripts/with-local-env.mjs",
        "run",
        "start"
      ]
    },
    "deployDryRun": {
      "program": "node",
      "args": [
        "scripts/pnpm.mjs",
        "run",
        "deploy:dry-run"
      ]
    }
  },
  "smoke": {
    "kind": "http",
    "host": "127.0.0.1",
    "port": 4341,
    "path": "/asisten-medis",
    "expectedStatus": 200,
    "startupTimeoutSeconds": 120
  },
  "artifacts": [
    ".next/BUILD_ID"
  ],
  "externalDependencies": [
    {
      "kind": "registry",
      "name": "npm registry",
      "locator": "https://registry.npmjs.org",
      "required": true
    },
    {
      "kind": "database",
      "name": "Turso (libSQL) for auth and pilot registration",
      "locator": "DATABASE_URL",
      "required": false
    },
    {
      "kind": "database",
      "name": "Turso auth token",
      "locator": "DATABASE_AUTH_TOKEN",
      "required": false
    },
    {
      "kind": "service",
      "name": "Resend for auth email",
      "locator": "RESEND_API_KEY",
      "required": false
    },
    {
      "kind": "service",
      "name": "Better Auth signing secret",
      "locator": "BETTER_AUTH_SECRET",
      "required": false
    },
    {
      "kind": "service",
      "name": "Better Auth base URL",
      "locator": "BETTER_AUTH_URL",
      "required": false
    },
    {
      "kind": "service",
      "name": "Google Gemini for /api/chat",
      "locator": "GOOGLE_GENERATIVE_AI_API_KEY",
      "required": false
    }
  ],
  "mutableStatePaths": [
    "node_modules",
    ".next",
    ".data",
    "next-env.d.ts",
    "tsconfig.tsbuildinfo"
  ]
}
